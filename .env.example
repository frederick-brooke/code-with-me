# Application base URL, used to build magic links in login emails.
# Defaults to http://localhost:3000.
APP_URL=http://localhost:3000

# Resend transactional email API key. When unset, login codes are shown on
# screen instead of emailed (local development). Get a key at
# https://resend.com/api-keys.
EMAIL_API_KEY=

# Verified sender used for login emails. Defaults to the Resend
# onboarding address if unset.
EMAIL_FROM=Code with Me <onboarding@resend.dev>

# Managed PostgreSQL connection string for the Prisma data layer (e.g. Neon,
# Supabase). In production use the pooled URL with sslmode=verify-full (the
# current pg behavior for require/prefer; the explicit mode avoids a deprecation
# warning). When unset, local development and the test suite keep using the
# in-memory stores (no DB runs). Production fails fast at startup without a
# configured database.
DATABASE_URL=

# ElevenLabs managed voice agent that plays the Assessor. When either is unset,
# the interview page shows the Assessor panel as not-configured.
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=

# Public base URL ElevenLabs' webhook tool uses to reach the app's
# /api/assessor/session-state endpoint. Must be reachable from ElevenLabs'
# servers (not localhost). Defaults to APP_URL. Configure once, then run
# `npm run assessor:configure` to (re)create and attach the webhook tool.
ASSESSOR_TOOL_BASE_URL=

# Shared secret the managed Assessor sends on its get_session_state webhook-tool
# requests (as the x-assessor-tool-secret header). The endpoint rejects requests
# without a matching secret, so configure the same value in the agent's tool.
ASSESSOR_TOOL_SECRET=

# The dedicated Performance Summary LLM call (ADR-0007). An OpenAI-compatible
# chat-completions endpoint; point these at the same provider/model your
# ElevenLabs agent is configured with so the summary comes from "the same LLM".
# When the API key is unset, the Session still ends but no summary is generated.
# Base URL e.g. https://api.openai.com/v1 (OpenAI) or
# https://openrouter.ai/api/v1 (OpenRouter) or https://api.groq.com/openai/v1.
SUMMARY_LLM_BASE_URL=
SUMMARY_LLM_API_KEY=
SUMMARY_LLM_MODEL=gpt-4o-mini